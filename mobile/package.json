{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "icons": "vue-dsfr-icons -s scripts/icons.js -t src/icon-collections.ts",
    "dev": "vite",
    "build": "npm run icons && vue-tsc -b && vite build",
    "build-dev": "npm run icons && vue-tsc -b && vite build --mode development",
    "build-emu": "npm run icons && vue-tsc -b && vite build --mode emulator",
    "build-staging": "npm run icons && vue-tsc -b && vite build --mode staging",
    "build-prod": "npm run icons && vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@gouvfr/dsfr": "^1.15.4",
    "@gouvminint/vue-dsfr": "^8.21.0",
    "@ionic/vue": "^9.0.11",
    "@ionic/vue-router": "^9.0.11",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "idb": "^8.0.4",
    "maplibre-gl": "^6.16.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "chalk": "^6.0.1",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
