{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "icons": "vue-dsfr-icons -s scripts/icons.js -t src/icon-collections.ts",
    "dev": "vite",
    "build": "npm run icons && vue-tsc -b && vite build",
    "build-dev": "npm run icons && vue-tsc -b && vite build --mode development",
    "build-emu": "npm run icons && vue-tsc -b && vite build --mode emulator",
    "build-staging": "npm run icons && vue-tsc -b && vite build --mode staging",
    "build-prod": "npm run icons && vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@gouvfr/dsfr": "^1.14.4",
    "@gouvminint/vue-dsfr": "^8.17.0",
    "@ionic/vue": "^8.8.11",
    "@ionic/vue-router": "^8.8.11",
    "@tailwindcss/vite": "^4.3.1",
    "@vueuse/core": "^14.3.0",
    "idb": "^8.0.3",
    "maplibre-gl": "^5.24.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "chalk": "^5.6.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
